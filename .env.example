# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ─── Sanity (public — safe to expose to the browser) ─────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=b9xxsvah
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_BASE_URL=https://www.supportiva.net

# ─── Sanity write token (SECRET — used only by the seed script) ──────────
# Generate at: https://www.sanity.io/manage → project → API → Tokens
# Permission: Editor. Delete the token after seeding is done.
SANITY_WRITE_TOKEN=

# ─── Resend (SECRET — sends contact form emails) ─────────────────────────
# Sign up at https://resend.com → API Keys
RESEND_API_KEY=

# Optional: override the "From" address (defaults to Resend's sandbox sender)
# CONTACT_FROM_ADDRESS=Supportiva <hello@supportiva.net>
